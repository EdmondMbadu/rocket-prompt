rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Shared storage rules for the rocket-prompt Firebase project.
    // This project backs both the rocket-prompt and rocket-goals apps.

    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /userProfiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /ai-attachments/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /prompts/{promptId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /collections/{collectionId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /organizations/{organizationId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /journey-photos/{goalId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /goal-visualizations/{goalId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /teams/{teamId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
